{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "galway",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_als"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			// REQUIRED FOR REMOTE DEPLOYMENT: replace with the real UUID from `wrangler d1 create galway-db`
			// Local dev works with any placeholder value — only remote deploy/migrate needs the real ID.
			"binding": "DB",
			"database_name": "galway-db",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "./drizzle"
		}
	],
	"send_email": [
		{
			// Cloudflare Email binding for admin alerts (production only)
			// Requires Cloudflare Email Routing to be enabled on your domain
			"name": "SEND_EMAIL"
		}
	],
	"vars": {
		// Email provider for account notifications: "resend" | "ses" | "smtp"
		"EMAIL_PROVIDER": "resend",
		// Sender address (must be verified in the chosen provider)
		"EMAIL_FROM": "",
		// Fallback admin alert recipient (overridden by notification_email in settings table)
		"ALERT_EMAIL_TO": ""
	}
	// Secrets (set via `wrangler secret put`):
	//   RESEND_API_KEY          — Resend API key
	//   AWS_ACCESS_KEY_ID       — AWS access key (SES)
	//   AWS_SECRET_ACCESS_KEY   — AWS secret key (SES)
	//   AWS_REGION              — AWS region e.g. ap-northeast-1 (SES)
	//   SMTP_API_URL            — HTTP relay endpoint (smtp mode)
	//   SMTP_API_KEY            — HTTP relay API key (smtp mode)
}
